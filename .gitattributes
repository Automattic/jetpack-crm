# Files not needed in the release zip.
#
# The release build (scripts/build-plugin.sh) uses an explicit ship_paths
# allow-list, so these export-ignore rules are belt-and-suspenders: they also
# take effect if anyone runs a plain `git archive` without paths.
/.git*                export-ignore
.gitattributes        export-ignore
.github/              export-ignore
.wordpress-org/       export-ignore
.wp-env.json          export-ignore
release.config.json   export-ignore
scripts/              export-ignore
tools/                export-ignore
tests/               export-ignore
docs/                 export-ignore
sass/                 export-ignore
Makefile              export-ignore
package.json          export-ignore
composer.json         export-ignore
composer.lock         export-ignore
webpack.config.js     export-ignore
babel.config.js       export-ignore
codeception.dist.yml  export-ignore
phpunit.*.xml.dist    export-ignore
.phpcs.xml.dist       export-ignore
AGENTS.md             export-ignore
CLAUDE.md             export-ignore
README.md             export-ignore

# Vendored brand logos, kept exactly as their owners publish them.
#
# core.autocrlf normalised woo-logo.svg's CRLF endings on commit, which changed
# its bytes and so broke the hashes recorded in i/welcome-to-zbs/LOGOS.md. That
# file's whole purpose is that the logos can be diffed against the vendor's own
# download, so these must not be touched.
i/welcome-to-zbs/*.svg  -text
